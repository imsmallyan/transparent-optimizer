<Window x:Class="PcOptimizer.ResidueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="残留清理" Width="820" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Background="{DynamicResource PageBg}" Foreground="{DynamicResource TextMain}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Headline" Style="{StaticResource H1}" FontSize="20" Text="正在查找残留…"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="只列出名称完全对得上的位置，被其他软件使用的位置已排除。文件夹会移到回收站，注册表会先备份成 .reg 文件，都可以恢复。"/>
        </StackPanel>

        <ProgressBar Grid.Row="1" x:Name="Progress" Style="{StaticResource Bar}" IsIndeterminate="True" Margin="0,14,0,0"/>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18" Foreground="{DynamicResource Good}"/>
                        <TextBlock Text="没有发现残留，卸载得很干净。" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" Margin="0,0,12,0"
                                              IsChecked="{Binding Checked, Mode=TwoWay}"/>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Margin="0,0,10,0" Width="52">
                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextSub}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"
                                                   Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Reason}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="关闭" Click="Close_Click" Margin="0,0,10,0" MinWidth="80" IsCancel="True"/>
                <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Content="清理所选" Click="Clean_Click"
                        FontSize="13" Padding="22,6" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
