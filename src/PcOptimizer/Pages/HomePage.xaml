<UserControl x:Class="PcOptimizer.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:LevelToBrush x:Key="LevelBrush"/>
        <local:LevelToGlyph x:Key="LevelGlyph"/>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="36,24,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="150" Height="150">
                <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="12"/>
                <Path x:Name="Arc" Stroke="{DynamicResource Primary}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ScoreText" Text="?" FontSize="46" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Primary}"/>
                    <TextBlock x:Name="ScoreUnit" Text="尚未体检" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Margin="36,8,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Text="建议立即体检 看看电脑状态如何" Style="{StaticResource H1}" FontSize="24"/>
                <TextBlock x:Name="Subline" Margin="0,8,0,0" Style="{StaticResource Sub}" FontSize="13"
                           Text="体检只读取信息，不会修改或删除任何东西。"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="CheckButton" Style="{StaticResource BigButton}" Content="立即体检" Click="Check_Click"/>
                    <Button x:Name="FixButton" Style="{StaticResource BigButton}" Content="一键清理垃圾" Click="Fix_Click"
                            Margin="14,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="ProgressPanel" Margin="0,20,0,0" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource Bar}" IsIndeterminate="True"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="Placeholder" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="体检会检查这 7 项"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="垃圾文件 · 回收站 · 开机启动项 · 软件残留 · 系统盘剩余空间 · 连续运行时间 · 病毒防护"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ResultList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,14,0">
                                        <Ellipse Fill="{Binding Level, Converter={StaticResource LevelBrush}}" Opacity="0.12"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18"
                                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                    </Grid>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{Binding ActionText}"
                                            Tag="{Binding ActionPage}" Click="Action_Click" VerticalAlignment="Center"
                                            Visibility="{Binding ActionText, Converter={StaticResource Vis}}"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="16" Margin="12,0"
                                               Text="{Binding Level, Converter={StaticResource LevelGlyph}}"
                                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Title}"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Detail}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,14,10,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="InfoRefresh_Click" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="我的电脑"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="以下信息全部在本机读取，不会上传到任何地方。"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl x:Name="InfoList" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14,10">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0">
                                        <Ellipse Fill="{DynamicResource PrimaryLight}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15" Foreground="{DynamicResource PrimaryDark}"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Value}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
