<UserControl x:Class="PcOptimizer.Pages.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="36,22,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="全部恢复默认" Click="RestoreAll_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6" Margin="0,0,10,0"
                    Content="一键关闭推荐项" Click="TurnOffRecommended_Click" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="隐私与广告"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,20,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="关掉 Windows 自带的广告、推荐和数据收集。改的都是 Windows 自己的设置，不停服务、不改系统文件，随时可以恢复默认。鼠标停在说明上可以看到具体改了哪个注册表值。"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="RestartButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="重启资源管理器"
                    Click="RestartExplorer_Click" Visibility="Collapsed" VerticalAlignment="Center"
                    ToolTip="有几项要重启资源管理器才生效。任务栏会消失几秒再出现，打开的文件夹窗口会关闭。"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" Margin="2,10,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          IsChecked="{Binding IsOn, Mode=OneWay}" Tag="{Binding}" Click="Toggle_Click"
                                          ToolTip="开：Windows 默认。关：关闭这项广告或数据收集。"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" ToolTip="{Binding StateTip}" Style="{StaticResource Sub}"
                                           VerticalAlignment="Center" Margin="16,0,10,0" MinWidth="56" TextAlignment="Right"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{Binding Title}"/>
                                        <Border Style="{StaticResource Tag}" Background="{DynamicResource PrimaryLight}" Visibility="{Binding Recommended, Converter={StaticResource Vis}}">
                                            <TextBlock Text="推荐关闭" FontSize="11" Foreground="{DynamicResource PrimaryDark}"/>
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Visibility="{Binding AdminTag, Converter={StaticResource Vis}}">
                                            <TextBlock Text="需要管理员" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Description}" ToolTip="{Binding Details}"
                                               TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
