<UserControl x:Class="PcOptimizer.Pages.Tools.AppsTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>
    <Grid Margin="36,10,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="RemoveButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6" Margin="0,0,10,0"
                    Content="删除所选" Click="Remove_Click" VerticalAlignment="Center" IsEnabled="False"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="预装应用清理"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,20,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="删除 Windows 自带或电脑厂商预装、平时用不到的应用。只对当前用户删除，大部分可以从 Microsoft Store 重新安装。应用商店、安全中心、运行库等系统需要的组件不会列出来。"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <CheckBox x:Name="ShowOther" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="10,0,6,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="OtherLabel" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="20,0,0,0" Text="显示其他应用"/>
            <Button DockPanel.Dock="Right" x:Name="SelectRecommended" Style="{StaticResource LinkButton}" Content="选中建议删除的"
                    Click="SelectRecommended_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="MessageCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" Margin="2,10,0,8"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="0,0,14,0"
                                              IsChecked="{Binding Selected, Mode=TwoWay}" Click="Select_Click"/>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{Binding Title}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding ThirdParty, Converter={StaticResource Vis}}">
                                                <TextBlock Text="第三方推广" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
                                        <TextBlock Style="{StaticResource Sub}" FontSize="11" Text="{Binding Meta}" Margin="0,2,0,0" Opacity="0.8"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="RemovedPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H2}" Text="删除过的应用" Margin="2,10,0,8"/>
                    <ItemsControl x:Name="RemovedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="20,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="在应用商店里装回"
                                                Tag="{Binding FamilyName}" Click="Reinstall_Click" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}" Text="{Binding WhenText}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
