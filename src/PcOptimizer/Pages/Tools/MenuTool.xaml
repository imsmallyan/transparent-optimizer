<UserControl x:Class="PcOptimizer.Pages.Tools.MenuTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>
    <Grid Margin="36,10,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="右键菜单管理"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="关掉开关只是隐藏，不删除任何东西，随时可以再打开。管理的是经典右键菜单（Win11 里在“显示更多选项”里）。“扩展组件”关掉后要重新打开资源管理器窗口才生效。大多数项目需要管理员权限才能修改。"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <CheckBox x:Name="ShowSystem" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="10,0,6,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="SystemLabel" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="20,0,0,0" Text="显示 Windows 自带的"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Sub}" Text="没有找到第三方软件添加的右键菜单项。"/>
                </Border>
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="Toggle_Click"
                                              ToolTip="开：在右键菜单里显示。关：隐藏。"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Sub}"
                                               VerticalAlignment="Center" Margin="16,0,10,0" Width="42"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                       ToolTip="{Binding Title}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource PrimaryLight}">
                                                <TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="{DynamicResource PrimaryDark}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding ShiftOnly, Converter={StaticResource Vis}}">
                                                <TextBlock Text="按住 Shift 才显示" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Meta}" ToolTip="{Binding Meta}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
