<UserControl x:Class="PcOptimizer.Pages.Tools.ShredTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="36,10,36,16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" x:Name="ShredButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6"
                    Background="{DynamicResource Bad}" Content="粉碎" Click="Shred_Click" VerticalAlignment="Center" IsEnabled="False"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="文件粉碎"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="先用随机数据把文件内容覆盖掉并写入磁盘，再改成随机文件名删除，恢复软件找不回内容和文件名。粉碎后无法恢复，也不会进回收站。"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource WarnLight}" BorderBrush="{DynamicResource Warn}" Margin="0,12,0,0" Padding="14,8">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMain}"
                       Text="注意：固态硬盘（SSD）会把写入挪到别的位置，覆盖不能保证旧数据在硬件上被擦掉；系统还原点、文件历史记录、网盘里的副本也不会被粉碎。系统和软件目录里的文件不允许粉碎。"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Sub}" Text="覆盖" VerticalAlignment="Center"/>
                <ComboBox x:Name="Passes" Margin="6,0,12,0" MinWidth="150" VerticalAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="1 遍（推荐）" Tag="1"/>
                    <ComboBoxItem Content="3 遍（更慢）" Tag="3"/>
                </ComboBox>
                <Button Style="{StaticResource GhostButton}" Content="添加文件" Click="AddFiles_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource GhostButton}" Content="添加文件夹" Click="AddFolder_Click"/>
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" Text="把文件或文件夹拖到这里，或点右边的按钮添加。"/>
        </DockPanel>

        <StackPanel Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="停止" Click="Stop_Click"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}"/>
            </DockPanel>
            <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Maximum="100" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="DropCard" Style="{StaticResource Card}" Padding="20,30" BorderBrush="{DynamicResource Line}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="28" Foreground="{DynamicResource TextSub}"/>
                        <TextBlock Style="{StaticResource Sub}" Text="拖到这里" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="移除" Tag="{Binding}"
                                            Click="Remove_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16"
                                               Foreground="{DynamicResource TextSub}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
