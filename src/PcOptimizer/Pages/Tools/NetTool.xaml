<UserControl x:Class="PcOptimizer.Pages.Tools.NetTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>
    <Grid Margin="36,10,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="联网控制"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="列表来自系统的连接表（和 netstat 相同），只显示点“刷新”那一刻的连接；想知道一段时间里哪些软件联过网，用“持续记录”。“监听的端口”里可以看到哪些程序在等待别的电脑连进来。禁止联网用的是 Windows 防火墙规则；限速用的是 Windows 自带的 QoS 策略，只能限制上传。修改需要管理员权限。"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" x:Name="WarnCard" Style="{StaticResource Card}" Background="{DynamicResource WarnLight}" BorderBrush="{DynamicResource Warn}"
                Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Border DockPanel.Dock="Left" Background="{DynamicResource Subtle}" CornerRadius="6" Padding="3" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabApps" Style="{StaticResource Segment}" GroupName="NetTab" Content="联网的软件" IsChecked="True" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabPorts" Style="{StaticResource Segment}" GroupName="NetTab" Content="监听的端口" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabRecord" Style="{StaticResource Segment}" GroupName="NetTab" Content="持续记录" Checked="Tab_Changed"/>
                </StackPanel>
            </Border>
            <CheckBox x:Name="ShowSystem" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="10,0,6,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="SystemLabel" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="20,0,0,0" Text="显示系统进程"/>
            <CheckBox x:Name="ShowUdp" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="10,0,6,0" Visibility="Collapsed"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="UdpLabel" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="20,0,0,0" Text="显示 UDP 端口"
                       Visibility="Collapsed" ToolTip="UDP 没有“连接”的概念，程序收发数据时都会占一个 UDP 端口，所以数量很多，大多不用管。"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        
        <Border x:Name="RecordHeader" Grid.Row="3" Style="{StaticResource Card}" Background="{DynamicResource Subtle}" Margin="0,10,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="RecordButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="开始记录"
                        Click="Record_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="RecordInfo" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                           Text="开始后每秒查看一次连接表，把这段时间里连过网的软件都列出来。记录只在这个页面开着时进行，离开页面就停止，不会在后台运行。不到一秒就断开的连接可能记不到；只记录 TCP 连接。以管理员身份运行时会改用精确模式，一次都不会漏。"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel x:Name="AppsPanel">
                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Sub}" Text="现在没有软件在联网。"/>
                </Border>
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="禁止联网" Tag="{Binding}"
                                            Click="Block_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            BorderBrush="{DynamicResource Bad}" Foreground="{DynamicResource Bad}"
                                            Visibility="{Binding CanBlock, Converter={StaticResource Vis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="允许联网" Tag="{Binding}"
                                            Click="Unblock_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding CanUnblock, Converter={StaticResource Vis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="上传限速" Tag="{Binding}"
                                            Click="Limit_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding CanControl, Converter={StaticResource Vis}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="340"
                                                       ToolTip="{Binding Path}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource BadLight}" Visibility="{Binding Blocked, Converter={StaticResource Vis}}">
                                                <TextBlock Text="已禁止联网" FontSize="11" Foreground="{DynamicResource Bad}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding HasLimit, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding LimitText}" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding IsSystem, Converter={StaticResource Vis}}">
                                                <TextBlock Text="系统" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Meta}" ToolTip="{Binding Meta}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel x:Name="PortsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Background="{DynamicResource Subtle}">
                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None"
                               Text="“其他电脑能连上”表示程序在本机以外的网络地址上等待连接，实际能不能连上还要看 Windows 防火墙和路由器的设置。标着“注意”的是远程控制、文件共享、数据库这类被别人连上会有风险的端口，不用的话建议关掉对应的功能。"/>
                </Border>
                <Border x:Name="PortsEmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Sub}" Text="现在没有端口在监听。"/>
                </Border>
                <ItemsControl x:Name="PortList">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" Margin="2,8,0,8"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" MinWidth="58" Height="42" CornerRadius="8" Margin="0,0,14,0" Padding="6,0"
                                            Background="{DynamicResource PrimaryLight}" VerticalAlignment="Top">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Port}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryDark}"/>
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryDark}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="禁止联网" Tag="{Binding}"
                                            Click="BlockPort_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            BorderBrush="{DynamicResource Bad}" Foreground="{DynamicResource Bad}"
                                            Visibility="{Binding CanBlock, Converter={StaticResource Vis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="允许联网" Tag="{Binding}"
                                            Click="UnblockPort_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding CanUnblock, Converter={StaticResource Vis}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding ServiceName}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding Risky, Converter={StaticResource Vis}}">
                                                <TextBlock Text="注意" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource BadLight}" Visibility="{Binding Blocked, Converter={StaticResource Vis}}">
                                                <TextBlock Text="已禁止联网" FontSize="11" Foreground="{DynamicResource Bad}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding IsSystem, Converter={StaticResource Vis}}">
                                                <TextBlock Text="系统" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Meta}" ToolTip="{Binding Path}" Margin="0,3,0,0"/>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Note}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"
                                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="RecordPanel" Visibility="Collapsed">
                <Border x:Name="RecordEmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock x:Name="RecordEmptyText" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
                <ItemsControl x:Name="RecordList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="禁止联网" Tag="{Binding}"
                                            Click="BlockSeen_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            BorderBrush="{DynamicResource Bad}" Foreground="{DynamicResource Bad}"
                                            Visibility="{Binding CanBlock, Converter={StaticResource Vis}}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="允许联网" Tag="{Binding}"
                                            Click="UnblockSeen_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding CanUnblock, Converter={StaticResource Vis}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="340"
                                                       ToolTip="{Binding Path}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource BadLight}" Visibility="{Binding Blocked, Converter={StaticResource Vis}}">
                                                <TextBlock Text="已禁止联网" FontSize="11" Foreground="{DynamicResource Bad}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding IsSystem, Converter={StaticResource Vis}}">
                                                <TextBlock Text="系统" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Meta}" ToolTip="{Binding RemotesText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
