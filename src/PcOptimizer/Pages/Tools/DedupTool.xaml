<UserControl x:Class="PcOptimizer.Pages.Tools.DedupTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,10,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" x:Name="DeleteButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6"
                    Content="删除所选" Click="Delete_Click" VerticalAlignment="Center" IsEnabled="False"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="文件去重"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="以 MD5 判断内容是否相同（只对大小相同的文件计算 MD5，大小不同的不可能重复）。每组默认保留最早的那个，删掉的文件进回收站。"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Sub}" Text="只看" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MinSize" Margin="6,0,12,0" Width="96" VerticalAlignment="Center" SelectedIndex="1">
                        <ComboBoxItem Content="全部文件" Tag="1"/>
                        <ComboBoxItem Content="≥ 100 KB" Tag="102400"/>
                        <ComboBoxItem Content="≥ 1 MB" Tag="1048576"/>
                        <ComboBoxItem Content="≥ 10 MB" Tag="10485760"/>
                    </ComboBox>
                    <Button Style="{StaticResource GhostButton}" Content="添加文件夹" Click="AddFolder_Click" Margin="0,0,10,0"/>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6" Content="开始查找" Click="Scan_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NoFolderText" Style="{StaticResource Sub}" Text="先添加要查找的文件夹，可以添加多个。"/>
                    <ItemsControl x:Name="FolderList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PrimaryLight}" CornerRadius="13" Padding="10,3,6,3" Margin="0,2,6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                Foreground="{DynamicResource TextSub}" Margin="8,0,2,0" Tag="{Binding}" Click="RemoveFolder_Click"
                                                VerticalAlignment="Center" ToolTip="移除"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="停止" Click="Stop_Click"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}"/>
            </DockPanel>
            <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Maximum="100" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="Summary" Style="{StaticResource Sub}" Margin="2,4,0,0"/>

        <ItemsControl Grid.Row="4" x:Name="GroupList" Margin="0,8,0,0"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HashText}" FontSize="11" Foreground="{DynamicResource TextSub}"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{Binding Title}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding Checked, Mode=TwoWay}" Click="File_Checked"
                                                      ToolTip="勾选 = 删除（移到回收站）"/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="打开位置" Tag="{Binding Path}"
                                                    Click="Reveal_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ModifiedText}" Style="{StaticResource Sub}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
