<UserControl x:Class="PcOptimizer.Pages.Tools.DefenderTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="36,10,36,16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" x:Name="QuickButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6"
                    Content="快速扫描" Click="Quick_Click" VerticalAlignment="Center" IsEnabled="False"
                    ToolTip="几分钟内检查最容易藏病毒木马的地方：正在运行的程序、开机启动项、系统关键位置。"/>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="病毒防护"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="用 Windows 自带的 Microsoft Defender 查杀病毒和木马。本工具不自带病毒库，只是把 Defender 的状态、扫描和查杀记录放到一起，方便查看。"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" x:Name="StateBadge" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource PrimaryLight}" VerticalAlignment="Top">
                    <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="22" Foreground="{DynamicResource Primary}"/>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock x:Name="StateTitle" Style="{StaticResource H2}" Text="正在读取防护状态…"/>
                    <TextBlock x:Name="StateDetail" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="FullButton" Style="{StaticResource GhostButton}" Content="全盘扫描" Click="Full_Click" Margin="0,0,10,0" IsEnabled="False"
                                ToolTip="检查所有磁盘上的所有文件，可能要一两个小时，期间电脑会变慢。"/>
                        <Button x:Name="FileButton" Style="{StaticResource GhostButton}" Content="扫描文件" Click="ScanFile_Click" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Content="扫描文件夹" Click="ScanFolder_Click" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}" Content="更新病毒库" Click="Update_Click" Margin="0,0,10,0" IsEnabled="False"
                                ToolTip="由 Defender 自己联网下载最新病毒库（本工具不联网）"/>
                        <Button Style="{StaticResource LinkButton}" Content="打开 Windows 安全中心" Click="OpenCenter_Click" VerticalAlignment="Center"
                                ToolTip="开关实时防护、恢复被误隔离的文件、添加信任，都在 Windows 安全中心里。"/>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                   Text="也可以直接把可疑的文件或文件夹拖到这里扫描。发现威胁时 Defender 会按它的默认设置处理（通常是隔离），被误隔离的文件可以在 Windows 安全中心里恢复。"/>

        <Border Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="StopButton" Style="{StaticResource LinkButton}" Content="停止" Click="Stop_Click"/>
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" FontSize="14"/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" IsIndeterminate="True" Margin="0,8,0,0"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" x:Name="ResultPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="ResultIcon" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="刷新" Click="Refresh_Click"/>
                <TextBlock Style="{StaticResource H2}" Text="Defender 查杀记录"/>
                <TextBlock x:Name="HistorySummary" Style="{StaticResource Sub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="NoThreats" Style="{StaticResource Sub}" Text="没有查杀记录，Defender 没有发现过威胁。" Visibility="Collapsed" Margin="0,4,0,0"/>
                    <ItemsControl x:Name="ThreatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Sub}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextMain}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Tag}" Background="{DynamicResource BadLight}">
                                                    <TextBlock Text="{Binding Severity}" FontSize="11" Foreground="{DynamicResource Bad}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Handled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Good}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
