<UserControl x:Class="PcOptimizer.Pages.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <Style x:Key="ToolTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="282" MinHeight="150" Style="{StaticResource Card}" Margin="0" Padding="20,18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid x:Name="HomePanel" Margin="36,22,36,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="更多功能"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="不常用、但用的时候很方便的小工具。"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,18,0,0">
                <Button Style="{StaticResource ToolTile}" Tag="update" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="软件更新" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="用 Windows 自带的 winget 查找有新版本的软件，一次全部更新。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="apps" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="预装应用清理" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="删除 Windows 和电脑厂商预装、平时用不到的应用，比如游戏和推广应用。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="defender" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="病毒防护" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="查看防护状态，用 Windows 自带的 Defender 查杀病毒木马。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="dedup" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="文件去重" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="按 MD5 找出内容完全相同的文件，保留一份，其余移到回收站。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="net" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="联网控制" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="看哪些软件正在联网、哪些端口在等别人连进来；可以禁止某个软件联网，或限制它的上传速度。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="menu" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource PrimaryLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE700;" FontSize="20" Foreground="{DynamicResource PrimaryDark}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="右键菜单管理" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="隐藏软件塞进右键菜单的项目，随时可以恢复。"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolTile}" Tag="shred" Click="Tool_Click">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource BadLight}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="20" Foreground="{DynamicResource Bad}"/>
                        </Border>
                        <TextBlock Style="{StaticResource H2}" Text="文件粉碎" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="覆盖文件内容后再删除，防止被恢复软件找回。"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <DockPanel x:Name="ToolPanel" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="36,12,36,0">
                <Button Style="{StaticResource LinkButton}" Content="‹ 返回更多功能" FontSize="13" Click="Back_Click" HorizontalAlignment="Left"/>
            </Border>
            <ContentControl x:Name="ToolHost"/>
        </DockPanel>
    </Grid>
</UserControl>
