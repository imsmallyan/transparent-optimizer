<UserControl x:Class="PcOptimizer.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="36,22,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="CleanBrokenButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6"
                    Click="CleanBroken_Click" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="开机启动项"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="关闭开关只是禁止开机自动运行，不会删除程序；和任务管理器“启动”页是同一套开关，随时可以打开。重启后生效。标红的是指向程序已不存在的失效项，可以删除（注册表项会先备份）。"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Sub}" Text="没有找到启动项。"/>
                </Border>
                <ItemsControl x:Name="ItemList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="Toggle_Click"
                                              ToolTip="开：开机自动运行。关：不自动运行。"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource Sub}"
                                               VerticalAlignment="Center" Margin="16,0,10,0" MinWidth="42"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="打开位置"
                                            Tag="{Binding}" Click="Reveal_Click" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Visibility="{Binding TargetMissing, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="删除这一项" Foreground="{DynamicResource Bad}"
                                            Tag="{Binding}" Click="RemoveOne_Click" VerticalAlignment="Center" Margin="16,0,0,0"
                                            Visibility="{Binding TargetMissing, Converter={StaticResource Vis}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Name}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}">
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource BadLight}" Visibility="{Binding TargetMissing, Converter={StaticResource Vis}}"
                                                    ToolTip="启动项指向的程序找不到了，通常是软件卸载后留下的。">
                                                <TextBlock Text="程序已不存在" FontSize="11" Foreground="{DynamicResource Bad}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}">
                                                <TextBlock Text="需管理员" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Command}" ToolTip="{Binding Command}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
