<UserControl x:Class="PcOptimizer.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="36,22,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="刷新" Click="Refresh_Click" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="EndSelectedButton" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="18,6"
                    Content="结束所选" Click="EndSelected_Click" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="False"/>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="内存优化"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                           Text="下面是你自己运行的软件（系统进程已排除），按占用从高到低排列。“结束”只管这一次；标着“开机自启”的，关掉自启下次开机才不会再出现。"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="MemPercent" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryDark}" Margin="16,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="MemText" Foreground="{DynamicResource TextMain}"/>
                    <ProgressBar x:Name="MemBar" Style="{StaticResource Bar}" Maximum="100" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,4,0,0">
            <CheckBox x:Name="BackgroundOnly" DockPanel.Dock="Right" Style="{StaticResource Check}" Margin="10,0,6,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="BackgroundLabel" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="20,0,0,0"
                       Text="只看后台运行的" ToolTip="没有窗口、在后台或托盘里运行的软件"/>
            <CheckBox x:Name="SelectAll" DockPanel.Dock="Left" Style="{StaticResource Check}" Margin="16,0,10,0"
                      Click="SelectAll_Click" ToolTip="全选当前列表"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Sub}" Text="没有找到符合条件的软件。"/>
                </Border>
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" Margin="0,0,12,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Checked, Mode=TwoWay}" Click="Item_Checked"/>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource PrimaryLight}">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="结束" Tag="{Binding}"
                                            Click="EndOne_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Width="80" TextAlignment="Right"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="关闭自启" Tag="{Binding}"
                                            Click="DisableStartup_Click" VerticalAlignment="Center" Margin="12,0,6,0"
                                            ToolTip="不再开机自动运行（随时可以在“启动加速”里打开）"
                                            Visibility="{Binding StartupEnabled, Converter={StaticResource Vis}}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Sub}"
                                               VerticalAlignment="Center" MaxWidth="220" TextWrapping="Wrap" TextTrimming="None" Margin="8,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                       ToolTip="{Binding Name}"/>
                                            <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding IsBackground, Converter={StaticResource Vis}}"
                                                    ToolTip="没有窗口，在后台或托盘里运行。">
                                                <TextBlock Text="后台" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding HasStartup, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding StartupText}" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Text="{Binding Meta}" ToolTip="{Binding Path}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
