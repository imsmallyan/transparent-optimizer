<UserControl x:Class="PcOptimizer.Pages.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcOptimizer">
    <UserControl.Resources>
        <local:ToVisibility x:Key="Vis"/>
    </UserControl.Resources>

    <Grid Margin="36,22,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Style="{StaticResource GhostButton}" Content="导出完整清单" Click="Export_Click"
                        Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="停止" Click="Stop_Click"
                        Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="开始扫描" Click="Scan_Click"/>
                <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Content="立即清理" Click="Clean_Click"
                        Margin="10,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="选择要扫描的项目"/>
                <TextBlock x:Name="Subline" Style="{StaticResource Sub}" Margin="0,6,0,0"
                           Text="只在下面这些固定目录里找文件，扫描不会删除任何东西。"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource Bar}" IsIndeterminate="True"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <ItemsControl x:Name="TargetList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Opacity="{Binding RowOpacity}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" Margin="0,0,14,0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Available}"/>
                                <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,14,0">
                                    <Ellipse Fill="{DynamicResource PrimaryLight}"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Target.Icon}" FontSize="17"
                                               Foreground="{DynamicResource PrimaryDark}"/>
                                </Grid>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="查看明细"
                                        Tag="{Binding}" Click="Detail_Click" VerticalAlignment="Center" Margin="16,0,0,0"
                                        Visibility="{Binding HasFiles, Converter={StaticResource Vis}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultText}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{Binding ResultBrush}" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Target.Name}"/>
                                        <Border Style="{StaticResource Tag}" Visibility="{Binding Target.NeedsAdmin, Converter={StaticResource Vis}}">
                                            <TextBlock Text="需管理员" FontSize="11" Foreground="{DynamicResource Warn}"/>
                                        </Border>
                                        <Border Style="{StaticResource Tag}" Background="{DynamicResource Subtle}" Visibility="{Binding NotFound, Converter={StaticResource Vis}}">
                                            <TextBlock Text="本机没有" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Target.Description}" Margin="0,3,0,0"
                                               ToolTip="{Binding RootsText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource H2}" Text="Windows 更新残留" Margin="2,10,0,4"/>
            <TextBlock Style="{StaticResource Sub}" Margin="2,0,0,10" TextWrapping="Wrap" TextTrimming="None"
                       Text="交给 Windows 自带的 DISM 清理，不在上面的扫描里，需要单独点。"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="32,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource PrimaryLight}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74C;" FontSize="17" Foreground="{DynamicResource PrimaryDark}"/>
                    </Grid>
                    <Button x:Name="SxsClean" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="清理" Click="SxsClean_Click"
                            VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="SxsAnalyze" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="分析" Click="SxsAnalyze_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="SxsSize" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H2}" Text="系统组件旧版本 WinSxS"/>
                            <Border Style="{StaticResource Tag}">
                                <TextBlock Text="需管理员" FontSize="11" Foreground="{DynamicResource Warn}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SxsText" Style="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Windows 更新后被新版本替换下来的系统组件。点“分析”看看能清理多少，分析要一两分钟。"/>
                        <ProgressBar x:Name="SxsBar" Style="{StaticResource Bar}" Margin="0,8,0,0" Visibility="Collapsed" Maximum="100"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="本工具自己的文件" Margin="2,10,0,10"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="32,0,14,0">
                        <Ellipse Fill="{DynamicResource PrimaryLight}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="17" Foreground="{DynamicResource PrimaryDark}"/>
                    </Grid>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="查看和清理" Click="Logs_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="LogSize" DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"
                               VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" Text="操作日志和备份"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="本工具每次操作的记录、卸载时的注册表备份。删除前可以逐个查看内容。"/>
                    </StackPanel>
                </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,6,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="32,0,14,0">
                    <Ellipse Fill="{DynamicResource PrimaryLight}"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="17" Foreground="{DynamicResource PrimaryDark}"/>
                </Grid>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="清空回收站" Click="EmptyBin_Click" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource H2}" Text="回收站"/>
                        <Button Style="{StaticResource LinkButton}" Content="打开回收站" Click="OpenBin_Click" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTip="在资源管理器里查看回收站里有什么。"/>
                    </StackPanel>
                    <TextBlock x:Name="BinText" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
